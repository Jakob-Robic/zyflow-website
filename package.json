{
  "name": "zyflow-landing",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:i18n": "node scripts/build-locale.js && node scripts/prepare-public.js",
    "annotate:i18n": "node scripts/annotate-html.js",
    "locales:export": "node scripts/export-locales.js",
    "build": "node scripts/build-locale.js && node scripts/prepare-public.js",
    "check:leaks": "node scripts/check-leaks.js",
    "build:rebuild": "node rebuild/scripts/build.js",
    "build:rebuild:prod": "SITE_INDEX=true node rebuild/scripts/build.js",
    "serve:rebuild": "python3 rebuild/serve.py",
    "test:rebuild": "node --test rebuild/scripts/test-attribution.js rebuild/scripts/test-asset-versioning.js rebuild/scripts/test-page-meta.js rebuild/scripts/test-app-store-links.js rebuild/scripts/test-image-delivery.js rebuild/scripts/test-publication.js rebuild/scripts/test-blog.js",
    "test:api": "node --test --test-concurrency=1 api/_lib/*.test.js",
    "serve:headers": "node rebuild/scripts/serve-headers.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "marked": "^18.1.0",
    "vanilla-cookieconsent": "^3.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "cheerio": "^1.0.0",
    "sharp": "^0.35.5"
  }
}
